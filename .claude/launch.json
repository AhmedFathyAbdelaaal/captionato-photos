{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "captionato-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start", "--", "--host", "127.0.0.1", "--port", "4200"],
      "port": 4200
    },
    {
      "name": "captionato-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
