# ── Database ──
DATABASE_URL=postgresql://photos:photos@localhost:5432/captionato_photos

# ── Auth / JWT ──
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Initial admin, seeded on first boot only.
ADMIN_USERNAME=capcap
ADMIN_PASSWORD=changeme

# ── Image storage (map a persistent volume here in Coolify) ──
PHOTOS_ORIGINAL_PATH=/data/photos/originals
PHOTOS_THUMB_PATH=/data/photos/thumbs
# ~2560px lightbox derivative (viewers get this, not the full original).
PHOTOS_DISPLAY_PATH=/data/photos/display

# ── Collage maker ──
# One-off (non-library) collage images; cleaned up on export or after
# COLLAGE_SWEEP_DAYS of draft inactivity.
COLLAGE_ONEOFF_PATH=/data/photos/collage-oneoffs
COLLAGE_SWEEP_DAYS=30

# ── CORS — comma-separated allowed origins ──
ALLOWED_ORIGINS=https://photos.captionato.tech,http://localhost:4200
